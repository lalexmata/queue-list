# ============================================
# RAILWAY CONFIGURATION
# ============================================
# Railway sets PORT automatically - DO NOT SET IT
# Railway sets NODE_ENV=production automatically

# Database Configuration (REQUIRED)
# Copy your Neon database URL here
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Application Configuration
ADMIN_KEY=your_admin_key_here
BROADCASTER_LOGIN=lalexmata

# ============================================
# SOCIAL MANAGER
# ============================================
# Contraseña para acceder a /social/upload
SOCIAL_ADMIN_PASSWORD=tu_contraseña_segura

# Clave secreta para las sesiones (cualquier string aleatorio largo)
SESSION_SECRET=cambia_esto_por_un_string_aleatorio_largo

# YouTube (Google Cloud Console → Credenciales → OAuth 2.0)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/social/youtube/callback

# Instagram (Meta Developer → Tu App → Instagram Graph API)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8080/api/social/instagram/callback

# TikTok (developers.tiktok.com → Tu App)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8080/api/social/tiktok/callback

# ============================================
# LOCAL DEVELOPMENT ONLY
# ============================================
# Uncomment for local development
# PORT=8080
# NODE_ENV=development
